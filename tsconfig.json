{
    "compilerOptions": {
        "module": "CommonJS",
        "target": "ES2020",
        "declaration": true,
        "outDir": "./dist",
        "strict": true,
        "paths": {
            "bitboard/*": ["./src/bitboard/*"],
            "common/*": ["./src/common/*"],
            "0x88/*": ["./src/0x88/*"]
        },
        "ignoreDeprecations": "6.0",
        "lib": [
            "ES2020",
            "DOM"
        ],
        "types": [
            "jest",
            "node"
        ]
    },
    "include": [
        "src/**/*.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}
